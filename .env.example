# Leave DATABASE_URL on these placeholders to run in local mode: the API serves the
# seed data from lib/seed.ts and keeps sync events in memory (no Postgres needed).
# Local dev without Docker: use the Supabase pooler URL directly.
DATABASE_URL=postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379
# Docker stack (pgbouncer sits in front of Supabase):
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.PROJECTREF
DB_PASSWORD=changeme
DB_NAME=postgres
CDN_URL=http://localhost:8081
